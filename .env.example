# Server
NODE_ENV=development
PORT=5004

# SMART reference DB (parts_info) - read only
PARTS_DB_HOST=127.0.0.1
PARTS_DB_PORT=5432
PARTS_DB_NAME=parts_info
PARTS_DB_USER=postgres
PARTS_DB_PASSWORD=postgres
# PARTS_DB_SSL=disable|prefer|require|verify-ca|verify-full

# Inventory DB (warehouse accounting) - read/write
INVENTORY_DB_HOST=127.0.0.1
INVENTORY_DB_PORT=5432
INVENTORY_DB_NAME=inventory
INVENTORY_DB_USER=postgres
INVENTORY_DB_PASSWORD=postgres
# INVENTORY_DB_SSL=disable|prefer|require|verify-ca|verify-full

# Optional startup behavior:
# DB_CONNECT_MAX_WAIT_MS=60000
# INVENTORY_DB_REQUIRED_ON_STARTUP=false
# INVENTORY_DB_BOOTSTRAP_RETRY_MS=5000
